<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DocFlow - Document Approval Workflow</title>

<style>
:root {
  --primary: #5b5ce2;
  --primary-dark: #4546c7;
  --bg: #f5f7fb;
  --surface: #ffffff;
  --text: #202338;
  --muted: #7d8296;
  --border: #e6e8f0;
  --success: #20a875;
  --danger: #df5d68;
  --warning: #d99522;
  --shadow: 0 12px 30px rgba(35, 38, 75, .08);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  min-height: 100vh;
  color: var(--text);
  background: var(--bg);
  font-family: Arial, Helvetica, sans-serif;
}

body.dark {
  --bg: #151722;
  --surface: #202331;
  --text: #f1f3fb;
  --muted: #a2a7bd;
  --border: #303446;
  --shadow: 0 12px 30px rgba(0, 0, 0, .25);
}

body.dark input,
body.dark textarea,
body.dark select {
  color: var(--text);
  background: #191b27;
}

button,
input,
textarea,
select {
  font: inherit;
}

button {
  cursor: pointer;
  border: none;
}

input,
textarea,
select {
  outline: none;
}

.hidden {
  display: none !important;
}

/* Header */

.topbar {
  height: 72px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28px;
  border-bottom: 1px solid var(--border);
  background: var(--surface);
}

.topbar-logo {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 19px;
  font-weight: bold;
}

.logo-icon {
  display: grid;
  place-items: center;
  width: 40px;
  height: 40px;
  border-radius: 12px;
  color: white;
  background: var(--primary);
  font-size: 22px;
}

.topbar-actions,
.user-area {
  display: flex;
  align-items: center;
  gap: 12px;
}

.connection-status {
  color: var(--success);
  font-size: 12px;
  font-weight: bold;
}

.theme-btn {
  width: 36px;
  height: 36px;
  border-radius: 9px;
  color: var(--text);
  background: #f0f1f7;
  font-size: 18px;
}

.profile-btn {
  padding: 9px 12px;
  border-radius: 9px;
  color: var(--primary);
  background: #eff0ff;
  font-size: 13px;
  font-weight: bold;
}

.avatar {
  display: grid;
  place-items: center;
  width: 35px;
  height: 35px;
  border-radius: 50%;
  color: white;
  background: var(--primary);
  font-size: 12px;
  font-weight: bold;
}

.user-area span {
  font-size: 14px;
  font-weight: bold;
}

/* Layout */

.layout {
  display: grid;
  grid-template-columns: 245px 1fr;
  min-height: calc(100vh - 72px);
}

.sidebar {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 24px 15px;
  border-right: 1px solid var(--border);
  background: var(--surface);
}

.nav-btn {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 14px;
  border-radius: 10px;
  color: #697087;
  background: transparent;
  text-align: left;
  font-size: 14px;
}

.nav-btn.active,
.nav-btn:hover {
  color: var(--primary);
  background: #f0f1ff;
}

.info-card {
  padding: 15px;
  margin-top: auto;
  border: 1px solid #e2e3ff;
  border-radius: 14px;
  background: #f5f5ff;
}

body.dark .info-card {
  background: #292c4a;
}

.info-card strong {
  display: block;
  margin-bottom: 7px;
  color: var(--primary);
  font-size: 13px;
}

.info-card p {
  color: var(--muted);
  font-size: 11px;
  line-height: 1.5;
}

.content {
  width: 100%;
  max-width: 1500px;
  padding: 36px;
  margin: auto;
}

.panel {
  display: none;
}

.panel.active {
  display: block;
}

.page-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 25px;
}

.eyebrow {
  margin-bottom: 8px;
  color: var(--primary);
  font-size: 11px;
  font-weight: bold;
  letter-spacing: .13em;
}

.page-heading h2 {
  margin-bottom: 7px;
  font-size: 32px;
}

.page-heading p:last-child {
  color: var(--muted);
}

/* Buttons */

.primary-btn,
.secondary-btn,
.approve-btn,
.reject-btn {
  padding: 12px 16px;
  border-radius: 10px;
  font-weight: bold;
  transition: .2s;
}

.primary-btn {
  color: white;
  background: var(--primary);
}

.primary-btn:hover {
  background: var(--primary-dark);
  transform: translateY(-1px);
}

.secondary-btn {
  color: var(--primary);
  background: #eff0ff;
}

.approve-btn {
  flex: 1;
  color: white;
  background: var(--success);
}

.reject-btn {
  flex: 1;
  color: white;
  background: var(--danger);
}

/* Statistics */

.stat-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 17px;
  margin-bottom: 22px;
}

.stat-card {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 20px;
  border: 1px solid var(--border);
  border-radius: 16px;
  background: var(--surface);
  box-shadow: var(--shadow);
}

.stat-icon {
  display: grid;
  place-items: center;
  width: 45px;
  height: 45px;
  border-radius: 13px;
  color: var(--primary);
  background: #f0f1ff;
  font-size: 21px;
  font-weight: bold;
}

.stat-card p {
  margin-bottom: 4px;
  color: var(--muted);
  font-size: 12px;
}

.stat-card h3 {
  font-size: 25px;
}

.dashboard-grid {
  display: grid;
  grid-template-columns: 1.3fr 1fr;
  gap: 22px;
}

.card {
  padding: 23px;
  border: 1px solid var(--border);
  border-radius: 17px;
  background: var(--surface);
  box-shadow: var(--shadow);
}

.card-header {
  display: flex;
  justify-content: space-between;
  gap: 15px;
  margin-bottom: 18px;
}

.card-header h3 {
  margin-bottom: 5px;
}

.card-header p {
  color: var(--muted);
  font-size: 13px;
}

.activity-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 13px 0;
  border-bottom: 1px solid var(--border);
}

.activity-item:last-child {
  border-bottom: none;
}

.activity-dot {
  flex-shrink: 0;
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: var(--primary);
}

.activity-item small {
  display: block;
  margin-top: 4px;
  color: var(--muted);
  font-size: 11px;
}

/* Documents */

.toolbar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 20px;
}

.search-box {
  width: min(500px, 100%);
  padding: 13px 15px;
  border: 1px solid var(--border);
  border-radius: 10px;
  color: var(--text);
  background: var(--surface);
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.filter-btn {
  padding: 9px 13px;
  border-radius: 9px;
  color: var(--muted);
  background: #eef0f7;
  font-size: 12px;
  font-weight: bold;
}

body.dark .theme-btn,
body.dark .profile-btn,
body.dark .filter-btn {
  background: #2b2e40;
}

.filter-btn.active {
  color: white;
  background: var(--primary);
}

.document-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 17px;
}

.document-card {
  display: flex;
  flex-direction: column;
  min-height: 270px;
  padding: 19px;
  border: 1px solid var(--border);
  border-radius: 16px;
  background: var(--surface);
  box-shadow: var(--shadow);
}

.document-card h3 {
  margin: 13px 0 8px;
  font-size: 17px;
}

.document-description {
  display: -webkit-box;
  overflow: hidden;
  margin-bottom: 14px;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.5;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.document-meta {
  display: grid;
  gap: 5px;
  margin-bottom: 16px;
  color: var(--muted);
  font-size: 11px;
}

.document-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin-top: auto;
}

.status {
  width: max-content;
  padding: 6px 9px;
  border-radius: 20px;
  font-size: 11px;
  font-weight: bold;
}

.status.Pending {
  color: var(--warning);
  background: #fff4d8;
}

.status.Approved {
  color: var(--success);
  background: #e9faf2;
}

.status.Rejected {
  color: var(--danger);
  background: #ffeaed;
}

.type-label {
  display: inline-block;
  width: max-content;
  padding: 6px 9px;
  border-radius: 8px;
  color: var(--primary);
  background: #f0f1ff;
  font-size: 11px;
  font-weight: bold;
}

.view-btn {
  padding: 7px 10px;
  border-radius: 8px;
  color: var(--primary);
  background: #eff0ff;
  font-size: 11px;
  font-weight: bold;
}

.approval-actions {
  display: flex;
  gap: 7px;
  margin-top: 15px;
}

/* Form */

.document-form {
  max-width: 760px;
}

.document-form input,
.document-form textarea,
.document-form select,
.modal-card input,
.modal-card textarea {
  width: 100%;
  padding: 13px 14px;
  border: 1px solid var(--border);
  border-radius: 10px;
  color: var(--text);
  background: #fbfbfe;
}

.document-form textarea {
  min-height: 150px;
  resize: vertical;
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 15px;
}

.form-actions {
  display: flex;
  gap: 10px;
  margin-top: 20px;
}

.helper-text {
  margin-top: 6px;
  color: var(--muted);
  font-size: 11px;
}

/* Modals */

.modal {
  position: fixed;
  z-index: 30;
  inset: 0;
  display: grid;
  place-items: center;
  padding: 20px;
  background: rgba(10, 12, 25, .65);
}

.modal-card {
  position: relative;
  width: min(520px, 100%);
  max-height: 90vh;
  overflow-y: auto;
  padding: 28px;
  border-radius: 18px;
  background: var(--surface);
  box-shadow: var(--shadow);
}

.modal-card h2 {
  margin-bottom: 8px;
}

.modal-card > p {
  margin-bottom: 18px;
  color: var(--muted);
  font-size: 13px;
}

.modal-card textarea {
  min-height: 120px;
  resize: vertical;
}

.modal-close {
  position: absolute;
  top: 12px;
  right: 17px;
  color: var(--muted);
  background: transparent;
  font-size: 25px;
}

.modal-card .primary-btn,
.modal-card .reject-btn {
  width: 100%;
  margin-top: 20px;
}

.settings-section {
  padding: 18px 0;
  border-top: 1px solid var(--border);
}

.settings-section h3 {
  margin-bottom: 10px;
  font-size: 15px;
}

.settings-message {
  min-height: 20px;
  margin-top: 12px;
  color: var(--danger);
  font-size: 13px;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--muted);
  font-size: 13px;
}

.switch-row input {
  width: 18px;
  height: 18px;
  accent-color: var(--primary);
}

.empty-state {
  padding: 30px 10px;
  color: var(--muted);
  text-align: center;
  font-size: 13px;
}

/* Toast */

#toast {
  position: fixed;
  z-index: 50;
  top: 90px;
  right: 24px;
  display: none;
  max-width: 320px;
  padding: 13px 17px;
  border-radius: 10px;
  color: white;
  background: #25283a;
  box-shadow: var(--shadow);
  font-size: 13px;
}

#toast.show {
  display: block;
}

/* Responsive */

@media (max-width: 1100px) {
  .document-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .stat-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .dashboard-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 760px) {
  .topbar {
    padding: 0 15px;
  }

  .connection-status,
  .profile-btn,
  .user-area span {
    display: none;
  }

  .layout {
    display: block;
  }

  .sidebar {
    flex-direction: row;
    overflow-x: auto;
    padding: 12px;
    border-right: none;
    border-bottom: 1px solid var(--border);
  }

  .info-card {
    display: none;
  }

  .nav-btn {
    min-width: max-content;
  }

  .content {
    padding: 24px 15px;
  }

  .page-heading {
    align-items: flex-start;
    flex-direction: column;
  }

  .document-grid {
    grid-template-columns: 1fr;
  }

  .form-row {
    grid-template-columns: 1fr;
  }
}
</style>
</head>

<body>

<div id="toast"></div>

<!-- HEADER -->

<header class="topbar">

  <div class="topbar-logo">
    <span class="logo-icon">✓</span>
    <span>DocFlow</span>
  </div>

  <div class="topbar-actions">

    <span id="connectionStatus" class="connection-status">
      Local demo mode
    </span>

    <button id="themeButton" class="theme-btn">
      ☾
    </button>

    <button id="profileButton" class="profile-btn">
      Profile
    </button>

    <button id="settingsButton" class="profile-btn">
      Settings
    </button>

    <div class="user-area">
      <div id="userAvatar" class="avatar">D</div>
      <span id="userName">Demo Reviewer</span>
    </div>
  </div>
</header>

<!-- APPLICATION -->

<main class="layout">

  <aside class="sidebar">

    <button class="nav-btn active" data-panel="dashboardPanel">
      <span>▥</span>
      Dashboard
    </button>

    <button class="nav-btn" data-panel="submitPanel">
      <span>＋</span>
      Submit Document
    </button>

    <button class="nav-btn" data-panel="documentsPanel">
      <span>▤</span>
      All Documents
    </button>

    <button class="nav-btn" data-panel="reviewPanel">
      <span>✓</span>
      Review Queue
    </button>

    <button class="nav-btn" data-panel="activityPanel">
      <span>◷</span>
      Activity Log
    </button>

    <div class="info-card">
      <strong>Local Demo Mode</strong>
      <p>
        Login has been removed. Data is stored in your browser.
        Connect Firebase later for cloud storage.
      </p>
    </div>
  </aside>

  <section class="content">

    <!-- DASHBOARD -->

    <div id="dashboardPanel" class="panel active">

      <div class="page-heading">
        <div>
          <p class="eyebrow">WORKSPACE OVERVIEW</p>
          <h2>Hello, <span id="headingName">Demo Reviewer</span> 👋</h2>
          <p>Monitor document submissions and approvals.</p>
        </div>

        <button id="dashboardSubmitButton" class="primary-btn">
          + Submit Document
        </button>
      </div>

      <div class="stat-grid">

        <div class="stat-card">
          <div class="stat-icon">▤</div>
          <div>
            <p>Total Documents</p>
            <h3 id="totalDocuments">0</h3>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-icon">◷</div>
          <div>
            <p>Pending</p>
            <h3 id="pendingDocuments">0</h3>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-icon">✓</div>
          <div>
            <p>Approved</p>
            <h3 id="approvedDocuments">0</h3>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-icon">!</div>
          <div>
            <p>Rejected</p>
            <h3 id="rejectedDocuments">0</h3>
          </div>
        </div>
      </div>

      <div class="dashboard-grid">

        <div class="card">
          <div class="card-header">
            <div>
              <h3>Recent Documents</h3>
              <p>Latest workflow activity</p>
            </div>
          </div>

          <div id="recentDocuments"></div>
        </div>

        <div class="card">
          <div class="card-header">
            <div>
              <h3>Workflow Steps</h3>
              <p>How the approval process works</p>
            </div>
          </div>

          <div class="activity-item">
            <span class="activity-dot"></span>
            <div>
              <strong>1. Submit</strong>
              <p class="helper-text">
                Employee submits a document.
              </p>
            </div>
          </div>

          <div class="activity-item">
            <span class="activity-dot"></span>
            <div>
              <strong>2. Review</strong>
              <p class="helper-text">
                Reviewer checks the document.
              </p>
            </div>
          </div>

          <div class="activity-item">
            <span class="activity-dot"></span>
            <div>
              <strong>3. Approve or Reject</strong>
              <p class="helper-text">
                Reviewer records a decision.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- SUBMIT DOCUMENT -->

    <div id="submitPanel" class="panel">

      <div class="page-heading">
        <div>
          <p class="eyebrow">DOCUMENT WORKFLOW</p>
          <h2>Submit Document</h2>
          <p>Send a document for approval.</p>
        </div>
      </div>

      <div class="card document-form">

        <form id="documentForm">

          <label>Document title</label>

          <input
            id="documentTitle"
            placeholder="Example: Project Proposal"
            required
          >

          <div class="form-row">

            <div>
              <label>Document type</label>

              <select id="documentType" required>
                <option value="">Select type</option>
                <option>Project Proposal</option>
                <option>Invoice</option>
                <option>Leave Request</option>
                <option>Certificate</option>
                <option>Report</option>
                <option>Other</option>
              </select>
            </div>

            <div>
              <label>Priority</label>

              <select id="documentPriority" required>
                <option value="Low">Low</option>
                <option value="Medium" selected>Medium</option>
                <option value="High">High</option>
              </select>
            </div>
          </div>

          <label>Document link</label>

          <input
            id="documentLink"
            type="url"
            placeholder="https://example.com/document"
          >

          <p class="helper-text">
            Paste a Google Drive, OneDrive, or hosted document link.
          </p>

          <label>Description</label>

          <textarea
            id="documentDescription"
            placeholder="Describe the document..."
            required
          ></textarea>

          <div class="form-actions">

            <button class="primary-btn" type="submit">
              Submit for Approval
            </button>

            <button
              id="clearDocumentButton"
              class="secondary-btn"
              type="button"
            >
              Clear
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- DOCUMENTS -->

    <div id="documentsPanel" class="panel">

      <div class="page-heading">
        <div>
          <p class="eyebrow">DOCUMENT MANAGEMENT</p>
          <h2>All Documents</h2>
          <p>Search and track submitted documents.</p>
        </div>
      </div>

      <div class="toolbar">

        <input
          id="documentSearch"
          class="search-box"
          placeholder="Search by title, type, or submitter..."
        >

        <div class="filter-row">

          <button class="filter-btn active" data-filter="All">
            All
          </button>

          <button class="filter-btn" data-filter="Pending">
            Pending
          </button>

          <button class="filter-btn" data-filter="Approved">
            Approved
          </button>

          <button class="filter-btn" data-filter="Rejected">
            Rejected
          </button>
        </div>
      </div>

      <div id="documentsGrid" class="document-grid"></div>
    </div>

    <!-- REVIEW QUEUE -->

    <div id="reviewPanel" class="panel">

      <div class="page-heading">
        <div>
          <p class="eyebrow">REVIEWER AREA</p>
          <h2>Review Queue</h2>
          <p>Approve or reject pending documents.</p>
        </div>
      </div>

      <div id="reviewGrid" class="document-grid"></div>
    </div>

    <!-- ACTIVITY -->

    <div id="activityPanel" class="panel">

      <div class="page-heading">
        <div>
          <p class="eyebrow">WORKFLOW HISTORY</p>
          <h2>Activity Log</h2>
          <p>View recent document actions.</p>
        </div>
      </div>

      <div id="activityList" class="card"></div>
    </div>

  </section>
</main>

<!-- PROFILE MODAL -->

<div id="profileModal" class="modal hidden">
  <div class="modal-card">

    <button id="closeProfileButton" class="modal-close">
      ×
    </button>

    <h2>Edit Profile</h2>
    <p>Update your display name and avatar color.</p>

    <label>Display name</label>
    <input id="profileNameInput" placeholder="Your name">

    <label>Avatar color</label>
    <input id="profileColorInput" type="color" value="#5b5ce2">

    <button id="saveProfileButton" class="primary-btn">
      Save Profile
    </button>
  </div>
</div>

<!-- SETTINGS MODAL -->

<div id="settingsModal" class="modal hidden">
  <div class="modal-card">

    <button id="closeSettingsButton" class="modal-close">
      ×
    </button>

    <h2>Settings</h2>
    <p>Manage your preferences.</p>

    <div class="settings-section">

      <h3>Notifications</h3>

      <label class="switch-row">
        <span>Enable notifications</span>
        <input id="notificationToggle" type="checkbox" checked>
      </label>
    </div>
  </div>
</div>

<!-- REJECTION MODAL -->

<div id="rejectModal" class="modal hidden">
  <div class="modal-card">

    <button id="closeRejectButton" class="modal-close">
      ×
    </button>

    <h2>Reject Document</h2>
    <p>Enter a reason for rejection.</p>

    <label>Rejection reason</label>

    <textarea
      id="rejectionReason"
      placeholder="Explain why this document was rejected..."
    ></textarea>

    <button id="confirmRejectButton" class="reject-btn">
      Confirm Rejection
    </button>

    <p id="rejectMessage" class="settings-message"></p>
  </div>
</div>

<script>
"use strict";

const $ = (id) => document.getElementById(id);

const DEMO_USER = {
  id: "demo-user",
  name: "Demo Reviewer",
  email: "demo@docflow.com"
};

let documents = JSON.parse(
  localStorage.getItem("docflow-documents") || "[]"
);

let activities = JSON.parse(
  localStorage.getItem("docflow-activities") || "[]"
);

let documentFilter = "All";
let searchText = "";
let selectedRejectId = null;

function saveData() {
  localStorage.setItem(
    "docflow-documents",
    JSON.stringify(documents)
  );

  localStorage.setItem(
    "docflow-activities",
    JSON.stringify(activities)
  );
}

function notify(message) {
  const enabled =
    localStorage.getItem("docflow-notifications") !== "false";

  if (!enabled) return;

  const toast = $("toast");

  toast.textContent = message;
  toast.classList.add("show");

  setTimeout(() => {
    toast.classList.remove("show");
  }, 2800);
}

function escapeHTML(value = "") {
  return String(value)
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");
}

function getInitials(name) {
  return name
    .split(" ")
    .map((part) => part[0])
    .join("")
    .slice(0, 2)
    .toUpperCase();
}

function formatDate(date) {
  if (!date) return "Just now";

  return new Date(date).toLocaleString();
}

function createActivity(action) {
  activities.unshift({
    id: Date.now(),
    action,
    userName: DEMO_USER.name,
    date: new Date().toISOString()
  });

  saveData();
  renderActivities();
}

function updateStats() {
  $("totalDocuments").textContent = documents.length;

  $("pendingDocuments").textContent =
    documents.filter((item) => item.status === "Pending").length;

  $("approvedDocuments").textContent =
    documents.filter((item) => item.status === "Approved").length;

  $("rejectedDocuments").textContent =
    documents.filter((item) => item.status === "Rejected").length;
}

function documentCard(item, reviewerMode = false) {
  const openLink = item.link
    ? `
      <a
        class="view-btn"
        href="${escapeHTML(item.link)}"
        target="_blank"
        rel="noopener"
      >
        Open
      </a>
    `
    : "";

  const approvalButtons =
    reviewerMode && item.status === "Pending"
      ? `
        <div class="approval-actions">
          <button
            class="approve-btn"
            data-approve="${item.id}"
          >
            Approve
          </button>

          <button
            class="reject-btn"
            data-reject="${item.id}"
          >
            Reject
          </button>
        </div>
      `
      : "";

  return `
    <article class="document-card">

      <span class="type-label">
        ${escapeHTML(item.type)}
      </span>

      <h3>${escapeHTML(item.title)}</h3>

      <p class="document-description">
        ${escapeHTML(item.description)}
      </p>

      <div class="document-meta">
        <span>
          Submitted by: ${escapeHTML(item.submittedBy)}
        </span>

        <span>
          Priority: ${escapeHTML(item.priority)}
        </span>

        <span>
          Created: ${formatDate(item.createdAt)}
        </span>

        ${
          item.reviewComment
            ? `<span>
                Comment: ${escapeHTML(item.reviewComment)}
              </span>`
            : ""
        }
      </div>

      <div class="document-footer">
        <span class="status ${escapeHTML(item.status)}">
          ${escapeHTML(item.status)}
        </span>

        ${openLink}
      </div>

      ${approvalButtons}
    </article>
  `;
}

function renderDocuments() {
  const filtered = documents.filter((item) => {
    const content = [
      item.title,
      item.type,
      item.priority,
      item.status,
      item.submittedBy,
      item.description
    ]
      .join(" ")
      .toLowerCase();

    const searchMatches =
      !searchText || content.includes(searchText);

    const statusMatches =
      documentFilter === "All" ||
      item.status === documentFilter;

    return searchMatches && statusMatches;
  });

  if (!filtered.length) {
    $("documentsGrid").innerHTML =
      `<p class="empty-state">No documents found.</p>`;
    return;
  }

  $("documentsGrid").innerHTML =
    filtered.map((item) => documentCard(item)).join("");

  attachApprovalButtons();
}

function renderReviewQueue() {
  const pending = documents.filter(
    (item) => item.status === "Pending"
  );

  if (!pending.length) {
    $("reviewGrid").innerHTML =
      `<p class="empty-state">No pending documents.</p>`;
    return;
  }

  $("reviewGrid").innerHTML =
    pending.map((item) => documentCard(item, true)).join("");

  attachApprovalButtons();
}

function renderRecentDocuments() {
  const recent = documents.slice(0, 5);

  if (!recent.length) {
    $("recentDocuments").innerHTML =
      `<p class="empty-state">No documents submitted yet.</p>`;
    return;
  }

  $("recentDocuments").innerHTML =
    recent.map((item) => `
      <div class="activity-item">
        <span class="activity-dot"></span>

        <div>
          <strong>${escapeHTML(item.title)}</strong>
          <p class="helper-text">
            ${escapeHTML(item.submittedBy)} ·
            ${escapeHTML(item.status)}
          </p>
        </div>

        <span class="status ${escapeHTML(item.status)}">
          ${escapeHTML(item.status)}
        </span>
      </div>
    `).join("");
}

function renderActivities() {
  if (!activities.length) {
    $("activityList").innerHTML =
      `<p class="empty-state">No activity yet.</p>`;
    return;
  }

  $("activityList").innerHTML =
    activities.slice(0, 30).map((item) => `
      <div class="activity-item">
        <span class="activity-dot"></span>

        <div>
          <p>
            <strong>${escapeHTML(item.userName)}</strong>
            ${escapeHTML(item.action)}
          </p>

          <small>${formatDate(item.date)}</small>
        </div>
      </div>
    `).join("");
}

function renderAll() {
  updateStats();
  renderDocuments();
  renderReviewQueue();
  renderRecentDocuments();
  renderActivities();
}

function attachApprovalButtons() {
  document.querySelectorAll("[data-approve]").forEach((button) => {
    button.addEventListener("click", () => {
      approveDocument(Number(button.dataset.approve));
    });
  });

  document.querySelectorAll("[data-reject]").forEach((button) => {
    button.addEventListener("click", () => {
      selectedRejectId = Number(button.dataset.reject);
      $("rejectionReason").value = "";
      $("rejectMessage").textContent = "";
      $("rejectModal").classList.remove("hidden");
    });
  });
}

function approveDocument(id) {
  const item = documents.find((documentItem) => {
    return documentItem.id === id;
  });

  if (!item) return;

  item.status = "Approved";
  item.reviewer = DEMO_USER.name;
  item.reviewComment = "Approved by reviewer";
  item.updatedAt = new Date().toISOString();

  createActivity(`approved "${item.title}"`);
  saveData();
  renderAll();
  notify("Document approved");
}

$("confirmRejectButton").addEventListener("click", () => {
  const reason = $("rejectionReason").value.trim();

  if (!reason) {
    $("rejectMessage").textContent =
      "Enter a rejection reason.";
    return;
  }

  const item = documents.find((documentItem) => {
    return documentItem.id === selectedRejectId;
  });

  if (!item) return;

  item.status = "Rejected";
  item.reviewer = DEMO_USER.name;
  item.reviewComment = reason;
  item.updatedAt = new Date().toISOString();

  createActivity(`rejected "${item.title}"`);
  saveData();
  renderAll();

  $("rejectModal").classList.add("hidden");
  notify("Document rejected");
});

$("closeRejectButton").addEventListener("click", () => {
  $("rejectModal").classList.add("hidden");
});

/* Submit document */

$("documentForm").addEventListener("submit", (event) => {
  event.preventDefault();

  const title = $("documentTitle").value.trim();
  const type = $("documentType").value;
  const priority = $("documentPriority").value;
  const link = $("documentLink").value.trim();
  const description = $("documentDescription").value.trim();

  if (!title || !type || !description) {
    notify("Complete all required fields");
    return;
  }

  const item = {
    id: Date.now(),
    title,
    type,
    priority,
    link,
    description,
    status: "Pending",
    submittedBy: DEMO_USER.name,
    createdAt: new Date().toISOString(),
    updatedAt: new Date().toISOString(),
    reviewer: "",
    reviewComment: ""
  };

  documents.unshift(item);
  saveData();
  createActivity(`submitted "${title}" for approval`);

  $("documentForm").reset();
  renderAll();
  notify("Document submitted successfully");
  openPanel("documentsPanel");
});

$("clearDocumentButton").addEventListener("click", () => {
  $("documentForm").reset();
});

/* Search */

$("documentSearch").addEventListener("input", (event) => {
  searchText = event.target.value.trim().toLowerCase();
  renderDocuments();
});

document.querySelectorAll("[data-filter]").forEach((button) => {
  button.addEventListener("click", () => {
    document.querySelectorAll("[data-filter]").forEach((item) => {
      item.classList.remove("active");
    });

    button.classList.add("active");
    documentFilter = button.dataset.filter;
    renderDocuments();
  });
});

/* Navigation */

function openPanel(panelId) {
  document.querySelectorAll(".panel").forEach((panel) => {
    panel.classList.toggle(
      "active",
      panel.id === panelId
    );
  });

  document.querySelectorAll(".nav-btn").forEach((button) => {
    button.classList.toggle(
      "active",
      button.dataset.panel === panelId
    );
  });
}

document.querySelectorAll(".nav-btn").forEach((button) => {
  button.addEventListener("click", () => {
    openPanel(button.dataset.panel);
  });
});

$("dashboardSubmitButton").addEventListener("click", () => {
  openPanel("submitPanel");
});

/* Theme */

const savedTheme =
  localStorage.getItem("docflow-dark") === "true";

document.body.classList.toggle("dark", savedTheme);
$("themeButton").textContent = savedTheme ? "☀" : "☾";

$("themeButton").addEventListener("click", () => {
  const dark = !document.body.classList.contains("dark");

  document.body.classList.toggle("dark", dark);
  localStorage.setItem("docflow-dark", String(dark));

  $("themeButton").textContent = dark ? "☀" : "☾";
});

/* Profile */

$("profileButton").addEventListener("click", () => {
  $("profileNameInput").value = DEMO_USER.name;

  $("profileColorInput").value =
    localStorage.getItem("docflow-avatar-color") ||
    "#5b5ce2";

  $("profileModal").classList.remove("hidden");
});

$("closeProfileButton").addEventListener("click", () => {
  $("profileModal").classList.add("hidden");
});

$("saveProfileButton").addEventListener("click", () => {
  const name = $("profileNameInput").value.trim();
  const color = $("profileColorInput").value;

  if (!name) {
    notify("Enter a valid name");
    return;
  }

  DEMO_USER.name = name;

  localStorage.setItem("docflow-avatar-color", color);

  $("userName").textContent = name;
  $("headingName").textContent = name;
  $("userAvatar").textContent = getInitials(name);
  $("userAvatar").style.background = color;

  $("profileModal").classList.add("hidden");
  notify("Profile updated");
});

/* Settings */

$("settingsButton").addEventListener("click", () => {
  $("settingsModal").classList.remove("hidden");
});

$("closeSettingsButton").addEventListener("click", () => {
  $("settingsModal").classList.add("hidden");
});

$("notificationToggle").checked =
  localStorage.getItem("docflow-notifications") !== "false";

$("notificationToggle").addEventListener("change", () => {
  localStorage.setItem(
    "docflow-notifications",
    String($("notificationToggle").checked)
  );

  notify(
    $("notificationToggle").checked
      ? "Notifications enabled"
      : "Notifications disabled"
  );
});

/* Close modals */

document.querySelectorAll(".modal").forEach((modal) => {
  modal.addEventListener("click", (event) => {
    if (event.target === modal) {
      modal.classList.add("hidden");
    }
  });
});

/* Initial UI */

const savedColor =
  localStorage.getItem("docflow-avatar-color") ||
  "#5b5ce2";

$("userAvatar").style.background = savedColor;
$("userAvatar").textContent = getInitials(DEMO_USER.name);
$("userName").textContent = DEMO_USER.name;
$("headingName").textContent = DEMO_USER.name;

renderAll();
</script>

</body>
</html>
